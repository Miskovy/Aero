generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(255)
  password_hash      String?   @db.VarChar(255)
  name               String    @db.VarChar(255)
  avatar_url         String?   @db.VarChar(500)
  auth_provider      String?   @default("local") @db.VarChar(50)
  auth_provider_id   String?   @db.VarChar(255)
  is_email_verified  Boolean   @default(false)
  two_factor_enabled Boolean?  @default(false)
  two_factor_secret  String?   @db.VarChar(255)
  last_login_at      DateTime? @db.Timestamptz(6)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  agreed_to_terms    Boolean   @default(false)
  agreed_to_privacy  Boolean   @default(false)
  agreed_to_cookies  Boolean   @default(false)

  api_keys             ApiKey[]
  audit_logs           AuditLog[]
  backups              Backup[]
  deployments          Deployment[]
  notifications        Notification[]
  organization_members OrganizationMember[]
  organizations        Organization[]
  payment_transactions PaymentTransaction[]
  refresh_tokens       RefreshToken[]
  team_members         TeamMember[]

  @@unique([auth_provider, auth_provider_id])
  @@index([email])
  @@index([created_at(sort: Desc)])
  @@map("users")
}

model OrganizationSubscription {
  id                   String             @id @default(uuid()) @db.Uuid
  organization_id      String             @unique @db.Uuid
  plan_id              String             @db.Uuid
  status               SubscriptionStatus @default(active)
  billing_cycle        BillingCycle       @default(monthly)
  current_period_start DateTime           @default(now()) @db.Timestamptz(6)
  current_period_end   DateTime?          @db.Timestamptz(6)
  cancel_at_period_end Boolean            @default(false)
  canceled_at          DateTime?          @db.Timestamptz(6)
  ended_at             DateTime?          @db.Timestamptz(6)
  trial_start_at       DateTime?          @db.Timestamptz(6)
  trial_end_at         DateTime?          @db.Timestamptz(6)
  metadata             Json?              @default("{}")
  created_at           DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?          @default(now()) @db.Timestamptz(6)

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  plan         Plan                 @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  payments     PaymentTransaction[]

  @@index([plan_id])
  @@index([status])
  @@index([current_period_end])
  @@map("organization_subscriptions")
}

model Organization {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(255)
  slug       String    @unique @db.VarChar(255)
  owner_id   String    @db.Uuid
  plan       String?   @default("free") @db.VarChar(50)
  plan_id    String?   @db.Uuid
  settings   Json?     @default("{}")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  alert_rules          AlertRule[]
  api_keys             ApiKey[]
  audit_logs           AuditLog[]
  git_sources          GitSource[]
  members              OrganizationMember[]
  nodes                Node[]
  owner                User                      @relation(fields: [owner_id], references: [id], onDelete: Restrict)
  payment_transactions PaymentTransaction[]
  plan_rel             Plan?                     @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  projects             Project[]
  subscription         OrganizationSubscription?
  teams                Team[]

  @@index([owner_id])
  @@index([plan_id])
  @@map("organizations")
}

model OrganizationMember {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  user_id         String       @db.Uuid
  role            OrgRole      @default(developer)
  joined_at       DateTime?    @default(now()) @db.Timestamptz(6)
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id])
  @@index([organization_id])
  @@index([user_id])
  @@index([role])
  @@map("organization_members")
}

model Team {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  name            String       @db.VarChar(255)
  description     String?
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  members         TeamMember[]
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("teams")
}

model TeamMember {
  id        String    @id @default(uuid()) @db.Uuid
  team_id   String    @db.Uuid
  user_id   String    @db.Uuid
  role      TeamRole  @default(member)
  joined_at DateTime? @default(now()) @db.Timestamptz(6)
  team      Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([team_id])
  @@index([user_id])
  @@map("team_members")
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  organization_id String        @db.Uuid
  name            String        @db.VarChar(255)
  slug            String        @db.VarChar(255)
  description     String?
  settings        Json?         @default("{}")
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?     @default(now()) @db.Timestamptz(6)
  environments    Environment[]
  organization    Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  services        Service[]

  @@unique([organization_id, slug])
  @@index([organization_id])
  @@map("projects")
}

model GitSource {
  id                     String       @id @default(uuid()) @db.Uuid
  organization_id        String       @db.Uuid
  provider               GitProvider
  name                   String       @db.VarChar(255)
  access_token_encrypted String
  webhook_secret         String?      @db.VarChar(255)
  owner_or_group         String?      @db.VarChar(255)
  connected_at           DateTime?    @default(now()) @db.Timestamptz(6)
  created_at             DateTime?    @default(now()) @db.Timestamptz(6)
  iv                     String
  auth_tag               String
  key_version            String?
  organization           Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  services               Service[]

  @@index([organization_id])
  @@map("git_sources")
}

model Node {
  id                String       @id @default(uuid()) @db.Uuid
  organization_id   String       @db.Uuid
  name              String       @db.VarChar(255)
  hostname          String       @db.VarChar(255)
  ip_address        String?      @db.VarChar(45)
  ssh_port          Int?         @default(22)
  status            NodeStatus?  @default(offline)
  role              NodeRole?    @default(worker)
  system_info       Json?        @default("{}")
  resource_capacity Json?        @default("{}")
  resource_usage    Json?        @default("{}")
  agent_token       String?      @unique @db.VarChar(255)
  last_heartbeat_at DateTime?    @db.Timestamptz(6)
  created_at        DateTime?    @default(now()) @db.Timestamptz(6)
  organization      Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  services          Service[]

  @@index([organization_id])
  @@index([status])
  @@map("nodes")
}

model Environment {
  id          String                @id @default(uuid()) @db.Uuid
  project_id  String                @db.Uuid
  name        String                @db.VarChar(100)
  slug        String                @db.VarChar(100)
  description String?
  git_branch  String?               @db.VarChar(255)
  created_at  DateTime?             @default(now()) @db.Timestamptz(6)
  variables   EnvironmentVariable[]
  project     Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, slug])
  @@index([project_id])
  @@map("environments")
}

model Service {
  id                   String                @id @default(uuid()) @db.Uuid
  project_id           String                @db.Uuid
  name                 String                @db.VarChar(255)
  slug                 String                @db.VarChar(255)
  type                 ServiceType           @default(application)
  source_type          SourceType
  docker_image         String?               @db.VarChar(500)
  docker_compose_path  String?               @db.VarChar(500)
  dockerfile_path      String?               @default("./Dockerfile") @db.VarChar(500)
  build_command        String?               @db.VarChar(1000)
  start_command        String?               @db.VarChar(1000)
  git_source_id        String?               @db.Uuid
  git_branch           String?               @default("main") @db.VarChar(255)
  git_subdirectory     String?               @db.VarChar(500)
  active_deployment_id String?               @db.Uuid
  status               ServiceStatus?        @default(stopped)
  resource_limits      Json?                 @default("{\"cpu\": \"1.0\", \"memory\": \"512m\"}")
  health_check         Json?                 @default("{}")
  restart_policy       Json?                 @default("{\"condition\": \"on-failure\", \"max_retries\": 5}")
  replicas             Int?                  @default(1)
  node_id              String?               @db.Uuid
  created_at           DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?             @default(now()) @db.Timestamptz(6)
  git_repository       String?               @db.VarChar(500)
  internal_port        Int?                  @default(3000)
  alert_rules          AlertRule[]
  backups              Backup[]
  deployments          Deployment[]          @relation("ServiceDeployments")
  variables            EnvironmentVariable[]
  domains              ServiceDomain[]
  secrets              ServiceSecret[]
  volumes              ServiceVolume[]
  webhooks             Webhook[]
  active_deployment    Deployment?           @relation("ActiveDeployment", fields: [active_deployment_id], references: [id])
  git_source           GitSource?            @relation(fields: [git_source_id], references: [id], onDelete: SetNull)
  node                 Node?                 @relation(fields: [node_id], references: [id], onDelete: SetNull)
  project              Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, slug])
  @@index([project_id])
  @@index([status])
  @@index([node_id])
  @@index([git_source_id])
  @@index([active_deployment_id])
  @@map("services")
}

model Deployment {
  id                 String             @id @default(uuid()) @db.Uuid
  service_id         String             @db.Uuid
  version            String?            @db.VarChar(50)
  git_commit_sha     String?            @db.VarChar(40)
  git_commit_message String?
  docker_image_tag   String?            @db.VarChar(500)
  status             DeploymentStatus?  @default(queued)
  trigger            DeploymentTrigger? @default(manual)
  triggered_by       String?            @db.Uuid
  started_at         DateTime?          @db.Timestamptz(6)
  finished_at        DateTime?          @db.Timestamptz(6)
  build_duration_ms  Int?
  build_logs_summary Json?
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  logs               DeploymentLog[]
  service            Service            @relation("ServiceDeployments", fields: [service_id], references: [id], onDelete: Cascade)
  user               User?              @relation(fields: [triggered_by], references: [id], onDelete: SetNull)
  active_in_services Service[]          @relation("ActiveDeployment")

  @@index([service_id])
  @@index([status])
  @@index([triggered_by])
  @@index([created_at(sort: Desc)])
  @@map("deployments")
}

model DeploymentLog {
  id            String     @id @default(uuid()) @db.Uuid
  deployment_id String     @db.Uuid
  phase         LogPhase
  level         LogLevel?  @default(info)
  message       String
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  deployment    Deployment @relation(fields: [deployment_id], references: [id], onDelete: Cascade)

  @@index([deployment_id])
  @@index([created_at(sort: Desc)])
  @@map("deployment_logs")
}

model EnvironmentVariable {
  id              String       @id @default(uuid()) @db.Uuid
  environment_id  String?      @db.Uuid
  service_id      String?      @db.Uuid
  key             String       @db.VarChar(255)
  encrypted_value String
  iv              String?      @db.VarChar(255)
  auth_tag        String?      @db.VarChar(255)
  is_secret       Boolean?     @default(false)
  description     String?      @db.VarChar(500)
  key_version     String?      @db.VarChar(50)
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @default(now()) @db.Timestamptz(6)
  environment     Environment? @relation(fields: [environment_id], references: [id], onDelete: Cascade)
  service         Service?     @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id])
  @@index([environment_id])
  @@map("environment_variables")
}

model ServiceSecret {
  id              String    @id @default(uuid()) @db.Uuid
  service_id      String    @db.Uuid
  key             String    @db.VarChar(255)
  encrypted_value String
  iv              String?   @db.VarChar(255)
  auth_tag        String?   @db.VarChar(255)
  description     String?   @db.VarChar(500)
  key_version     String?   @db.VarChar(50)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  service         Service   @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([service_id, key])
  @@index([service_id])
  @@map("service_secrets")
}

model ServiceDomain {
  id                   String              @id @default(uuid()) @db.Uuid
  service_id           String              @db.Uuid
  domain               String              @unique @db.VarChar(255)
  type                 DomainType?         @default(auto_generated)
  ssl_enabled          Boolean?            @default(true)
  ssl_certificate_path String?             @db.VarChar(500)
  verification_status  VerificationStatus? @default(pending)
  verification_token   String?             @db.VarChar(255)
  verified_at          DateTime?           @db.Timestamptz(6)
  created_at           DateTime?           @default(now()) @db.Timestamptz(6)
  service              Service             @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id])
  @@map("service_domains")
}

model ServiceVolume {
  id         String    @id @default(uuid()) @db.Uuid
  service_id String    @db.Uuid
  name       String    @db.VarChar(255)
  mount_path String    @db.VarChar(500)
  host_path  String?   @db.VarChar(500)
  driver     String?   @default("local") @db.VarChar(100)
  size_bytes BigInt?   @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  service    Service   @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id])
  @@map("service_volumes")
}

model Backup {
  id           String         @id @default(uuid()) @db.Uuid
  service_id   String         @db.Uuid
  filename     String         @db.VarChar(500)
  size_bytes   BigInt?        @default(0)
  storage_path String         @db.VarChar(500)
  status       BackupStatus?  @default(queued)
  trigger      BackupTrigger? @default(manual)
  triggered_by String?        @db.Uuid
  started_at   DateTime?      @db.Timestamptz(6)
  finished_at  DateTime?      @db.Timestamptz(6)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  service      Service        @relation(fields: [service_id], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [triggered_by], references: [id], onDelete: SetNull)

  @@index([service_id])
  @@index([status])
  @@index([triggered_by])
  @@map("backups")
}

model AlertRule {
  id                String         @id @default(uuid()) @db.Uuid
  organization_id   String         @db.Uuid
  service_id        String?        @db.Uuid
  name              String         @db.VarChar(255)
  metric            AlertMetric
  operator          AlertOperator
  threshold         Float
  duration_seconds  Int?           @default(60)
  channel           AlertChannel
  channel_config    Json?          @default("{}")
  enabled           Boolean?       @default(true)
  last_triggered_at DateTime?      @db.Timestamptz(6)
  created_at        DateTime?      @default(now()) @db.Timestamptz(6)
  organization      Organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  service           Service?       @relation(fields: [service_id], references: [id], onDelete: Cascade)
  notifications     Notification[]

  @@index([organization_id])
  @@index([service_id])
  @@map("alert_rules")
}

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  alert_rule_id String?             @db.Uuid
  user_id       String?             @db.Uuid
  title         String              @db.VarChar(255)
  message       String?
  channel       AlertChannel
  status        NotificationStatus? @default(pending)
  metadata      Json?               @default("{}")
  sent_at       DateTime?           @db.Timestamptz(6)
  read_at       DateTime?           @db.Timestamptz(6)
  created_at    DateTime?           @default(now()) @db.Timestamptz(6)
  alert_rule    AlertRule?          @relation(fields: [alert_rule_id], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([alert_rule_id])
  @@index([status])
  @@map("notifications")
}

model AuditLog {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  user_id         String?      @db.Uuid
  action          String       @db.VarChar(100)
  resource_type   String       @db.VarChar(100)
  resource_id     String?      @db.Uuid
  old_value       Json?
  new_value       Json?
  ip_address      String?      @db.VarChar(45)
  user_agent      String?      @db.VarChar(500)
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([user_id])
  @@index([resource_type, resource_id])
  @@index([created_at(sort: Desc)])
  @@map("audit_logs")
}

model ApiKey {
  id              String        @id @default(uuid()) @db.Uuid
  user_id         String        @db.Uuid
  organization_id String?       @db.Uuid
  name            String        @db.VarChar(255)
  key_hash        String        @unique @db.VarChar(255)
  key_prefix      String        @db.VarChar(10)
  permissions     Json?         @default("[\"*\"]")
  last_used_at    DateTime?     @db.Timestamptz(6)
  expires_at      DateTime?     @db.Timestamptz(6)
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([organization_id])
  @@map("api_keys")
}

model Webhook {
  id                String          @id @default(uuid()) @db.Uuid
  service_id        String          @db.Uuid
  name              String          @db.VarChar(255)
  provider          WebhookProvider @default(github)
  secret_token      String          @unique @db.VarChar(255)
  events            Json?           @default("[\"push\"]")
  branch_filter     String?         @db.VarChar(255)
  is_active         Boolean         @default(true)
  last_triggered_at DateTime?       @db.Timestamptz(6)
  last_status       String?         @db.VarChar(50)
  created_at        DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?       @default(now()) @db.Timestamptz(6)
  service           Service         @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id])
  @@map("webhooks")
}

model Plan {
  id                   String                     @id @default(uuid()) @db.Uuid
  name                 String                     @db.VarChar(255)
  price                Int                        @db.Integer
  max_projects         Int?                       @default(1)
  is_inf_proj          Boolean                    @default(false)
  max_nodes            Int?                       @default(1)
  is_inf_nodes         Boolean                    @default(false)
  max_services         Int?                       @default(3)
  is_inf_services      Boolean                    @default(false)
  max_deployments      Int?                       @default(50)
  is_inf_deployments   Boolean                    @default(false)
  max_backups          Int?                       @default(5)
  is_inf_backups       Boolean                    @default(false)
  max_webhooks         Int?                       @default(3)
  is_inf_webhooks      Boolean                    @default(false)
  max_apikeys          Int?                       @default(2)
  is_inf_apikeys       Boolean                    @default(false)
  max_alerts           Int?                       @default(5)
  is_inf_alerts        Boolean                    @default(false)
  custom_domains       Boolean                    @default(false)
  max_teams            Int?                       @default(1)
  is_inf_teams         Boolean                    @default(false)
  max_members          Int?                       @default(5)
  is_inf_members       Boolean                    @default(false)
  max_organizations    Int?                       @default(1)
  is_inf_organizations Boolean                    @default(false)
  is_active            Boolean                    @default(true)
  created_at           DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?                  @default(now()) @db.Timestamptz(6)
  organizations        Organization[]
  payment_transactions PaymentTransaction[]
  subscriptions        OrganizationSubscription[]

  @@map("plans")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique @db.VarChar(128)
  family_id  String   @db.Uuid
  is_revoked Boolean  @default(false)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@map("refresh_tokens")
}

model PaymentTransaction {
  id                  String        @id @default(uuid()) @db.Uuid
  organization_id     String        @db.Uuid
  subscription_id     String?       @db.Uuid
  plan_id             String?       @db.Uuid
  user_id             String?       @db.Uuid
  xpay_session_id     String?       @unique @db.VarChar(255)
  xpay_payment_intent String?       @db.VarChar(255)
  amount              Int // Amount in piasters or base unit
  currency            String        @default("EGP") @db.VarChar(10)
  status              PaymentStatus @default(pending)
  payment_method      String?       @db.VarChar(50)
  checkout_url        String?       @db.Text
  error_message       String?       @db.Text
  metadata            Json?         @default("{}")
  created_at          DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?     @default(now()) @db.Timestamptz(6)

  organization Organization              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  subscription OrganizationSubscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  plan         Plan?                     @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  user         User?                     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([subscription_id])
  @@index([plan_id])
  @@index([user_id])
  @@index([status])
  @@index([created_at(sort: Desc)])
  @@map("payment_transactions")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  unpaid
  incomplete
  expired
}

enum BillingCycle {
  monthly
  yearly
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  cancelled
}

enum WebhookProvider {
  github
  gitlab
  bitbucket
  custom
}

enum OrgRole {
  owner
  admin
  developer
  viewer
}

enum TeamRole {
  lead
  member
}

enum ServiceType {
