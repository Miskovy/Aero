# ─── Aero PaaS Production Environment Variables Blueprint ─────────────────────
# Copy this file to .env inside infrastructure/ directory on your production server:
#   cp .env.production.example .env

NODE_ENV=production
PORT=3000

# ─── 1. Security & Cryptography (REQUIRED) ──────────────────────────────────
# 64-character hex master key for VaultService AES-256-GCM envelope encryption
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AERO_VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secrets for authentication and refresh token rotation
JWT_SECRET=super-secret-production-jwt-access-key-change-this-in-prod-2026
JWT_REFRESH_SECRET=super-secret-production-jwt-refresh-key-change-this-in-prod-2026

# ─── 2. Database Connection ──────────────────────────────────────────────────
POSTGRES_USER=aero
POSTGRES_PASSWORD=AeroProdSecurePassword2026!
POSTGRES_DB=aero_production
DATABASE_URL=postgresql://aero:AeroProdSecurePassword2026!@postgres:5432/aero_production?schema=public

# ─── 3. Redis Connection ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ─── 4. Domain & Network CORS ────────────────────────────────────────────────
AERO_CORS_ORIGINS=http://localhost:3001,https://dashboard.aero-cloud.app,https://aero-cloud.app

# Frontend public URLs
NEXT_PUBLIC_API_URL=https://api.aero-cloud.app/api/v1
NEXT_PUBLIC_WS_URL=wss://api.aero-cloud.app

# ─── 5. Cloudflare Tunnel Integration (Optional) ──────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
